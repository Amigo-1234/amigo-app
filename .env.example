# Copy to .env.local for local development. Never commit real values.

# ---------------------------------------------------------------- app (Vite)
# Which backend the app uses: supabase | firebase | demo
# Unset = firebase (legacy) — production stays on Firebase until cutover.
VITE_DATA_SOURCE=supabase

# Supabase → Project Settings → API. Both values are public (safe in the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Older projects: VITE_SUPABASE_ANON_KEY=<anon JWT> works too.)

# Let people migrated from Firebase sign in with their old password
# (calls the legacy-sign-in Edge Function). Turn off once migration is done.
VITE_LEGACY_SIGNIN=true

# ----------------------------------------- migration scripts (Node, NOT Vite)
# These are secrets. Use them only from a trusted machine, never in Vercel.

# Postgres connection string (Supabase → Connect → Session pooler).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>

# Firebase Admin service account JSON for amigo-world-ebfab
# (Firebase console → Project settings → Service accounts → Generate new private key).
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# ------------------------------- Edge Function secrets (supabase secrets set)
# LEGACY_SIGNIN_ENABLED=true
# FIREBASE_WEB_API_KEY=AIzaSyA7LCr6HouDusvM0Yot261PvLidOCvG0oY
# ALLOWED_ORIGINS=https://<your-domain>,https://<preview-domain>

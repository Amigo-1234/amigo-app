# Copy to .env.local for local development. Never commit real values.

# ---------------------------------------------------------------- app (Vite)
# Which backend the app uses: supabase | firebase | demo
# Unset = firebase (legacy) — production stays on Firebase until cutover.
VITE_DATA_SOURCE=supabase

# Supabase → Project Settings → API. Both values are public (safe in the browser).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Older projects: VITE_SUPABASE_ANON_KEY=<anon JWT> works too.)

# Let people migrated from Firebase sign in with their old password
# (calls the legacy-sign-in Edge Function). Turn off once migration is done.
VITE_LEGACY_SIGNIN=true

# ----------------------------------------- migration scripts (Node, NOT Vite)
# Secrets. Put them in the cloud environment's settings (environment variables)
# or a git-ignored .env.local — never in Git, docs, or Vercel.

# Supabase → Project Settings → API keys → secret key (or legacy service_role).
# The migration talks to Supabase over HTTPS only (Data API + Auth admin + Storage).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<secret key>

# Firebase Admin service account for amigo-world-ebfab, base64 of the whole JSON file
# (Firebase console → Project settings → Service accounts → Generate new private key):
#   base64 -w0 amigo-world-ebfab-firebase-adminsdk.json
# Parsed in memory only, never written to disk or logged.
FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the service-account JSON>

# Local tests only (plain Postgres + shim):
# DATABASE_URL=postgresql://postgres@localhost:54329/amigo

# ------------------------------- Edge Function secrets (supabase secrets set)
# LEGACY_SIGNIN_ENABLED=true
# FIREBASE_WEB_API_KEY=AIzaSyA7LCr6HouDusvM0Yot261PvLidOCvG0oY
# LEGACY_SIGNIN_HASH_KEY=<random 32+ characters, e.g. openssl rand -hex 32>
# ALLOWED_ORIGINS=https://<your-domain>,https://<preview-domain>

# Demo builds only: email shown for the demo's signed-in owner account (admin + verified).
# Set it in Vercel (Preview, branch-scoped) — not in git.
# VITE_DEMO_OWNER_EMAIL=
